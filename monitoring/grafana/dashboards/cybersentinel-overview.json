{
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "HTTP Request Rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(cybersentinel_http_requests_total[1m]))",
          "legendFormat": "requests/sec"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Requests by Status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(cybersentinel_http_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Average API Latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(cybersentinel_http_request_duration_seconds_sum[5m])) / sum(rate(cybersentinel_http_request_duration_seconds_count[5m]))",
          "legendFormat": "seconds"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Requests by Endpoint",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (path) (rate(cybersentinel_http_requests_total[5m]))",
          "legendFormat": "{{path}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "type": "stat",
      "title": "API Availability SLO",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "cybersentinel:http_availability:ratio_5m", "legendFormat": "availability"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.995}]}}},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 16}
    },
    {
      "type": "stat",
      "title": "API P95 Latency",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "cybersentinel:http_latency_p95_seconds:5m", "legendFormat": "p95"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.5}]}}},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 16}
    },
    {
      "type": "stat",
      "title": "PostgreSQL Availability",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "cybersentinel_dependency_up{dependency=\"postgresql\"}", "legendFormat": "database"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}] }},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 16}
    },
    {
      "type": "stat",
      "title": "Copilot Fallbacks (5m)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(increase(cybersentinel_copilot_requests_total{outcome=\"fallback_unavailable\"}[5m]))", "legendFormat": "fallbacks"}],
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 16}
    },
    {
      "type": "logs",
      "title": "Centralized Service Logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{service=~\"api|worker|frontend|postgres\"}", "refId": "A"}],
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 24}
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": [
    "cybersentinel",
    "security",
    "observability"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "CyberSentinel AI Overview",
  "uid": "cybersentinel-overview",
  "version": 2
}
