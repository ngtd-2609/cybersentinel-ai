[Unit]
Description=CyberSentinel %i disposable restore drill
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=cybersentinel
Group=cybersentinel
WorkingDirectory=/opt/cybersentinel/%i/current
EnvironmentFile=/etc/cybersentinel/%i-backup.env
ExecStart=/usr/bin/bash scripts/backup-restore-drill.sh
PrivateTmp=true
NoNewPrivileges=true
