POSTGRES_USER=cybersentinel
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=cybersentinel

CYBERSENTINEL_DATABASE_URL=postgresql+psycopg://cybersentinel:replace-with-a-long-random-database-password@postgres:5432/cybersentinel

CYBERSENTINEL_OLLAMA_URL=http://host.docker.internal:11434

CYBERSENTINEL_OLLAMA_MODEL=qwen3:4b

CYBERSENTINEL_APP_NAME=CyberSentinel AI

CYBERSENTINEL_ENVIRONMENT=production
CYBERSENTINEL_ENFORCE_PRODUCTION_CONFIG=true

CYBERSENTINEL_SECRET_KEY=change-this-to-a-random-secret

CYBERSENTINEL_CORS_ORIGINS=https://cybersentinel.example.com
CYBERSENTINEL_TRUSTED_HOSTS=cybersentinel.example.com,localhost,127.0.0.1
CYBERSENTINEL_LOGIN_RATE_LIMIT_ATTEMPTS=5
CYBERSENTINEL_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
CYBERSENTINEL_REDIS_URL=redis://redis:6379/0
CYBERSENTINEL_RATE_LIMIT_FAIL_CLOSED=true
CYBERSENTINEL_TRUST_PROXY_HEADERS=true
CYBERSENTINEL_INGESTION_API_KEYS=replace-with-a-long-random-agent-key
CYBERSENTINEL_INGESTION_BATCH_SIZE=500
CYBERSENTINEL_INGESTION_MAX_ATTEMPTS=5
CYBERSENTINEL_INGESTION_WORKER_POLL_SECONDS=1.0
CYBERSENTINEL_CORRELATION_WINDOW_MINUTES=30
CYBERSENTINEL_NOTIFICATION_WEBHOOK_URL=
CYBERSENTINEL_NOTIFICATION_SLACK_WEBHOOK_URL=
CYBERSENTINEL_REALTIME_CHANNEL=cybersentinel:soc-updates
CYBERSENTINEL_MODEL_MIN_PRECISION=0.80
CYBERSENTINEL_MODEL_MIN_RECALL=0.25
CYBERSENTINEL_MODEL_MIN_F1=0.40
CYBERSENTINEL_MODEL_MAX_FALSE_POSITIVE_RATE=0.05
CYBERSENTINEL_DRIFT_WARNING_THRESHOLD=0.20
CYBERSENTINEL_DRIFT_CRITICAL_THRESHOLD=0.30
CYBERSENTINEL_OLLAMA_MAX_RETRIES=2
CYBERSENTINEL_OLLAMA_CIRCUIT_FAILURE_THRESHOLD=3
CYBERSENTINEL_OLLAMA_CIRCUIT_RESET_SECONDS=30
CYBERSENTINEL_ALLOW_EXTERNAL_AI=false
CYBERSENTINEL_ALLOW_SENSITIVE_EXTERNAL_AI=false
CYBERSENTINEL_PUBLIC_REGISTRATION_ENABLED=false
CYBERSENTINEL_ACCOUNT_LOCKOUT_ATTEMPTS=5
CYBERSENTINEL_ACCOUNT_LOCKOUT_MINUTES=15

CYBERSENTINEL_AUTO_INCIDENT_RISK_THRESHOLD=85

CYBERSENTINEL_OLLAMA_TIMEOUT=180
CYBERSENTINEL_OLLAMA_NUM_PREDICT=384
