POSTGRES_USER=cybersentinel
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=cybersentinel

CYBERSENTINEL_DATABASE_URL=postgresql+psycopg://cybersentinel:replace-with-a-long-random-database-password@postgres:5432/cybersentinel

CYBERSENTINEL_OLLAMA_URL=http://host.docker.internal:11434

CYBERSENTINEL_OLLAMA_MODEL=qwen3:4b

CYBERSENTINEL_APP_NAME=CyberSentinel AI

CYBERSENTINEL_ENVIRONMENT=production
CYBERSENTINEL_ENFORCE_PRODUCTION_CONFIG=true

CYBERSENTINEL_SECRET_KEY=change-this-to-a-random-secret

CYBERSENTINEL_CORS_ORIGINS=https://cybersentinel.example.com
CYBERSENTINEL_TRUSTED_HOSTS=cybersentinel.example.com,localhost,127.0.0.1
CYBERSENTINEL_LOGIN_RATE_LIMIT_ATTEMPTS=5
CYBERSENTINEL_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
CYBERSENTINEL_PUBLIC_REGISTRATION_ENABLED=false
CYBERSENTINEL_ACCOUNT_LOCKOUT_ATTEMPTS=5
CYBERSENTINEL_ACCOUNT_LOCKOUT_MINUTES=15

CYBERSENTINEL_AUTO_INCIDENT_RISK_THRESHOLD=85

CYBERSENTINEL_OLLAMA_TIMEOUT=180
CYBERSENTINEL_OLLAMA_NUM_PREDICT=384
