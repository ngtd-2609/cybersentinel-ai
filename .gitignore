# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environment
.venv/

# Environment / secrets
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Data
data/raw/*
data/interim/*
data/processed/*
data/external/*

# Keep data directories in Git
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Model / generated artifacts
artifacts/*
!artifacts/.gitkeep

# MLflow local runtime
mlruns/
mlartifacts/
mlflow.db

# Logs / temporary
*.log
tmp/
temp/
backups/
deploy/certs/
deploy/secrets/
deploy/state/

# Local credentials
*.pem
*.key

# Keep DVC metadata files in data directories
!data/raw/*.dvc
!data/interim/*.dvc
!data/processed/*.dvc
!data/external/*.dvc

# Allow DVC metadata for versioned production models
!artifacts/*/
artifacts/*/*
!artifacts/*/*.dvc

# Local application database
cybersentinel.db
*.db-journal
*.db-shm
*.db-wal

# Local environment files
.env
.env.*
!.env.example
